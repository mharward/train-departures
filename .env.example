# Darwin (National Rail) API Token - Used by Netlify Edge Function
# Register at: https://realtime.nationalrail.co.uk/OpenLDBWSRegistration
DARWIN_ACCESS_TOKEN=your-token-here

# TfL API Key - Used by edge function (optional, for higher rate limits)
# Register at: https://api-portal.tfl.gov.uk/
TFL_API_KEY=your-key-here
